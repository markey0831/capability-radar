# Frontend build-time values. Never put secrets in variables prefixed with VITE_.
VITE_API_BASE_URL=https://api.example.com

# CloudBase server-only values. Configure these in CloudBase, not in EdgeOne.
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173
ADMIN_PASSWORD_SALT=replace-with-generated-salt
ADMIN_PASSWORD_HASH=replace-with-generated-scrypt-hash
SESSION_SIGNING_KEY=replace-with-at-least-32-random-bytes
TASK_TOKEN_SIGNING_KEY=replace-with-at-least-32-random-bytes
BACKUP_ENCRYPTION_KEY=replace-with-32-byte-base64-key
CLOUDBASE_ENV_ID=replace-with-cloudbase-env-id
